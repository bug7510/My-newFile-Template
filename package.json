{
  "name": "mynewfiletemplate",
  "displayName": "MyNewFileTemplate",
  "description": "can sets settings about new file",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MyNewFileTemplate",
      "properties": {
        "MyNewFileTemplate.Templates": {
          "type": "array",
          "description": "ファイル作成時に参照するテンプレートを設定できます。\n{filePath[0]}は入力したファイル名。\n{filePath[1]}はファイルが作成されるフォルダ名。\n{filePath[2]}はその上のフォルダ、{filePath[3]}はその上の……",
          "default": [
            {
              "templateName": "空のテキストファイル",
              "filename": "{filePath[0]}.txt",
              "template": ""
            },
            {
              "templateName": "HTML: ボイラープレート",
              "filename": "{filePath[0]}.html",
              "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title></title>\n</head>\n<body>\n\n</body>\n</html>"
            },
            {
              "templateName": "Markdown: ドキュメント",
              "filename": "{filePath[0]}.md",
              "template": "# {filePath[0]}\n\n- [{filePath[0]}](#{filePath[0]})\n"
            },
            {
              "templateName": "C#: クラスファイル（Namespaceなし）",
              "filename": "{filePath[0]}.cs",
              "template": "public class {filePath[0]}{\n    \n}"
            },
            {
              "templateName": "C#: クラスファイル（Namespaceあり）",
              "filename": "{filePath[0]}.cs",
              "template": "namespace {filePath[1]}{\n    public class {filePath[0]}{\n        \n    }\n}"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "templateName": {
                "type": "string",
                "description": "クイックピックに表示されるテンプレートの名前。",
                "default": "新しいテンプレート"
              },
              "filename": {
                "type": "string",
                "description": "このテンプレートで作成されるファイルのデフォルト名。",
                "default": "{filePath[0]}.txt"
              },
              "template": {
                "type": "string",
                "description": "作成されるファイルのデフォルトの内容。",
                "default": ""
              }
            },
            "required": [
              "templateName",
              "filename",
              "template"
            ],
            "additionalProperties": false
          }
        },
        "MyNewFileTemplate.whiteList": {
          "type": "array",
          "description": "現在のワークスペースでクイックピックに表示しないテンプレートの名前リスト。",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "default": []
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "MyNewFileTemplate.create",
          "when": "explorerResourceIsFolder||explorerResourceIsRoot",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "MyNewFileTemplate.create",
        "title": "テンプレートから選択"
      },
      {
        "command": "fileCreator.hideTemplateInWorkspace",
        "title": "ワークスペース内のテンプレート表示設定"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}