{
  "name": "mynewfiletemplate",
  "displayName": "My newFile Template",
  "description": "Let newFile more Easy.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "publisher": "bug7510",
  "repository": {
    "type": "git",
    "url": "https://github.com/bug7510/My-newFile-template.git"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MyNewFileTemplate",
      "properties": {
        "MyNewFileTemplate.Templates": {
          "type": "array",
          "markdownDescription": "ファイル作成時に参照するテンプレートを設定できます。\n\n\n\n\n{filePath[1]}のように、テンプレート内で{filePath[]}の\"[]\"内に数値を入れた文字列を挿入すると、ファイル作成時、それらのプレースホルダーはパスを利用した文字列に置換され。ファイルの内容が作成されます。\n{filePath[0]}は入力されたファイル名です。\n\n[ワークスペースのテンプレート表示設定](command:MyNewFileTemplate.template.workspace.hide)\n\n[テンプレートの編集](command:MyNewFileTemplate.template.global)",
          "default": [
            {
              "templateName": "空のテキストファイル",
              "filename": "{filePath[0]}.txt",
              "template": ""
            },
            {
              "templateName": "HTML: ボイラープレート",
              "filename": "{filePath[0]}.html",
              "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title></title>\n</head>\n<body>\n\n</body>\n</html>"
            },
            {
              "templateName": "Markdown: ドキュメント",
              "filename": "{filePath[0]}.md",
              "template": "# {filePath[0]}\n\n- [{filePath[0]}](#{filePath[0]})\n"
            },
            {
              "templateName": "C#: クラスファイル（Namespaceなし）",
              "filename": "{filePath[0]}.cs",
              "template": "public class {filePath[0]}{\n    \n}"
            },
            {
              "templateName": "C#: クラスファイル（Namespaceあり）",
              "filename": "{filePath[0]}.cs",
              "template": "namespace {filePath[1]}{\n    public class {filePath[0]}{\n        \n    }\n}"
            },
            {
              "templateName": "Unity:MonoBehabiour",
              "filename": "{filePath[0]}.cs",
              "template": "using UnityEngine;\n\npublic class {filePath[0]}:MonoBehaviour\n{\n    \n}\n"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "templateName": {
                "type": "string",
                "description": "クイックピックに表示されるテンプレートの名前。",
                "default": "新しいテンプレート"
              },
              "filename": {
                "type": "string",
                "description": "このテンプレートで作成されるファイルのデフォルト名。",
                "default": "{filePath[0]}.txt"
              },
              "template": {
                "type": "string",
                "description": "作成されるファイルのデフォルトの内容。",
                "default": ""
              }
            },
            "default": {
              "templateName": "新しいテンプレート",
              "filename": "{filePath[0]}.txt",
              "template": ""
            },
            "required": [
              "templateName",
              "filename",
              "template"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "MyNewFileTemplate.newFile",
          "when": "explorerResourceIsFolder||explorerResourceIsRoot",
          "group": "navigation@1"
        },
        {
          "command": "MyNewFileTemplate.templateFromFile",
          "when": "!explorerResourceIsFolder&&!explorerResourceIsRoot",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "MyNewFileTemplate.newFile",
        "title": "テンプレートから作成",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.templateFromFile",
        "title": "ファイルからテンプレートを作成",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.workspace.hide",
        "title": "ワークスペース内のテンプレート表示設定",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.global",
        "title": "テンプレート編集",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.global.create",
        "title": "新規テンプレート作成",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.global.edit",
        "title": "既存テンプレート編集",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.global.duplicate",
        "title": "既存テンプレートから新規テンプレートを作成",
        "category": "MyNewFileTemplate"
      },
      {
        "command": "MyNewFileTemplate.template.global.delete",
        "title": "既存テンプレート削除",
        "category": "MyNewFileTemplate"
      }
    ]
  },
  "scripts": {
    "make-package": "npm run refer-Document&&npx vsce package&&npm run hide-Document",
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch --mode development --config ./configs/webpack.config.js",
    "package": "webpack --mode production --config ./configs/webpack.config.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "refer-Document": "npm run refer-README&&npm run refer-CHANGELOG&&npm run refer-LICENSE",
    "refer-README": "node -e \"require('fs').copyFileSync('docs/README.md', 'README.md');\"&&node -e \"require('fs').copyFileSync('docs/README.ja.md', 'README.ja.md');\"",
    "refer-CHANGELOG": "node -e \"require('fs').copyFileSync('docs/CHANGELOG.md', 'CHANGELOG.md');\"",
    "refer-LICENSE": "node -e \"require('fs').copyFileSync('docs/LICENSE.md', 'LICENSE.md');\"",
    "hide-Document": "npm run hide-README&&npm run hide-CHANGELOG&&npm run hide-LICENSE",
    "hide-README": "node -e \"require('fs').unlinkSync('README.md');\"&&node -e \"require('fs').unlinkSync('README.ja.md');\"",
    "hide-CHANGELOG": "node -e \"require('fs').unlinkSync('CHANGELOG.md');\"",
    "hide-LICENSE": "node -e \"require('fs').unlinkSync('LICENSE.md');\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.47",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.25.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}