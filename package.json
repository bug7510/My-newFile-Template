{
  "name": "newfiletemplate",
  "displayName": "NewFileTemplate",
  "description": "can sets settings about new file",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Templates Settings",
      "properties": {
        "Templates": {
          "type": "array",
          "description": "ファイル作成時に参照するテンプレートを設定できます。",
          "default": [
            {
              "templateName": "空のファイル",
              "filename": "{filePath[0]}.txt",
              "template": ""
            },
            {
              "templateName": "HTMLボイラープレート",
              "filename": "{filePath[0]}.html",
              "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title></title>\n</head>\n<body>\n\n</body>\n</html>"
            },
            {
              "templateName": "Markdownドキュメント",
              "filename": "{filePath[0]}.md",
              "template": "# タイトル\n\n本文\n"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "templateName": {
                "type": "string",
                "description": "クイックピックに表示されるテンプレートの名前。",
                "default": "新しいテンプレート"
              },
              "filename": {
                "type": "string",
                "description": "このテンプレートで作成されるファイルのデフォルト名。",
                "default": "{filePath[0]}.txt"
              },
              "template": {
                "type": "string",
                "description": "作成されるファイルのデフォルトの内容。",
                "default": ""
              }
            }
          }
        }
      }
    },
    "submenus": [
      {
        "id": "NewFileTemplates",
        "label": "New File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "NewFileTemplates",
          "when": "explorerResourceIsFolder||explorerResourceIsRoot",
          "group": "navigation@1"
        }
      ],
      "NewFileTemplates": [
        {
          "command": "NewFileTemplate.create"
        }
      ]
    },
    "commands": [
      {
        "command": "NewFileTemplate.create",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}